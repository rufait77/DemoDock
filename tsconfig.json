{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@rufait77/demodock": ["./packages/demodock/src/index.ts"],
      "@rufait77/demodock/react": ["./packages/demodock/src/react.tsx"]
    }
  },
  "include": ["apps", "packages", "tests", "*.config.ts"],
  "exclude": ["node_modules", "**/dist"]
}
